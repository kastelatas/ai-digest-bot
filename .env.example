# Скопируйте в .env и заполните. Файл .env не должен попасть в git / публичные чаты.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ LLM для написания черновиков — нужен ТОЛЬКО тот, что соответствует llm.provider в config.yaml.
# OpenRouter (openrouter.ai/keys) — provider: "openrouter"
OPENROUTER_API_KEY=
# Anthropic (console.anthropic.com) — provider: "anthropic"
ANTHROPIC_API_KEY=

# Опционально, для модуля реальных просмотров через MTProto (см. README → Метрики)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
