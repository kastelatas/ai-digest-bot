# Скопируйте в .env и заполните. Файл .env не должен попасть в git / публичные чаты.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ Anthropic API (console.anthropic.com) — используется для написания черновиков постов
ANTHROPIC_API_KEY=

# Опционально, для модуля реальных просмотров через MTProto (см. README → Метрики)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
