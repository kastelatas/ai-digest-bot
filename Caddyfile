# HTTPS-прокси перед панелью: сертификат Let's Encrypt выпускается и продлевается автоматически.
# Домен берётся из PANEL_DOMAIN (.env). Для доступа по IP подойдёт вид 1-2-3-4.sslip.io.
{$PANEL_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy panel:8080
}
